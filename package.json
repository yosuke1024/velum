{
  "name": "velum",
  "version": "0.1.0",
  "private": true,
  "description": "A fictional world whose five inhabitants become the companions of PixTale — a Character Story Engine, with the Season 1 diary engine kept as legacy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "day": "tsx scripts/run-day.ts",
    "plan": "tsx scripts/plan-season.ts",
    "snapshot": "tsx scripts/compile-snapshot.ts",
    "appraisal": "tsx scripts/compile-appraisal.ts",
    "story:plan": "tsx scripts/story-plan.ts",
    "story:write": "tsx scripts/story-write.ts",
    "export": "tsx scripts/export-site.ts",
    "export:feed": "tsx scripts/export-feed.ts",
    "portraits": "tsx scripts/derive-portraits.ts"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
